{
  "name": "kavalab",
  "version": "1.0.0",
  "description": "КаваLab — сайт кавʼярні з конструктором напою (самостійна робота з веброзробки)",
  "scripts": {
    "build": "tailwindcss -i src/input.css -o public/css/styles.css --minify",
    "dev": "tailwindcss -i src/input.css -o public/css/styles.css --watch",
    "serve": "npx --yes serve public -l 5173",
    "test": "node --test tests/*.test.js",
    "lint:html": "html-validate \"public/**/*.html\"",
    "check": "npm run build && npm run lint:html && npm test"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "html-validate": "^11.4.0",
    "tailwindcss": "^4.3.5"
  },
  "private": true
}
